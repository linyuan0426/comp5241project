# Supabase project settings. The publishable key is safe in the browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key

# Server only. Set the key for the provider you choose.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace_with_deepseek_api_key

# To use OpenRouter, set AI_PROVIDER=openrouter and fill this key.
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
